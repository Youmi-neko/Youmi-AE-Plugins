// VERSIONINFO for YO_Shitsukan.aex. ASCII only.
#include <winver.h>
#include "ShitsukanConfig.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SK_FILEVERSION
 PRODUCTVERSION SK_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Youmi"
            VALUE "FileDescription", "YO Shitsukan texture / line-keeping blur / watercolor effect plug-in"
            VALUE "FileVersion", SK_VERSION_STR
            VALUE "InternalName", "YO_Shitsukan"
            VALUE "OriginalFilename", "YO_Shitsukan.aex"
            VALUE "ProductName", SK_NAME
            VALUE "ProductVersion", SK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
