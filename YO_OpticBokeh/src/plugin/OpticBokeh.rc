// VERSIONINFO for YO_OpticBokeh.aex / YO_OpticBokehKantan.aex (rc /DOB_KANTAN). ASCII only.
#include <winver.h>
#include "OpticBokehConfig.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OB_FILEVERSION
 PRODUCTVERSION OB_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Youmi"
            VALUE "FileDescription", OB_RC_DESCRIPTION
            VALUE "FileVersion", OB_VERSION_STR
            VALUE "InternalName", OB_RC_INTERNAL
            VALUE "OriginalFilename", OB_RC_FILENAME
            VALUE "ProductName", OB_NAME
            VALUE "ProductVersion", OB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
