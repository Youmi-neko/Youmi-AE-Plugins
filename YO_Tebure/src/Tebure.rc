// VERSIONINFO for YO_Tebure.aex. ASCII only.
#include <winver.h>
#include "TebureConfig.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TB_FILEVERSION
 PRODUCTVERSION TB_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Youmi"
            VALUE "FileDescription", "YO Tebure Shake camera shake effect plug-in"
            VALUE "FileVersion", TB_VERSION_STR
            VALUE "InternalName", "YO_Tebure"
            VALUE "OriginalFilename", "YO_Tebure.aex"
            VALUE "ProductName", TB_NAME
            VALUE "ProductVersion", TB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

