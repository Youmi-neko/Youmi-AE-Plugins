# Windows PiPL chain, run as a script so paths with non-ASCII characters survive (cmd /c mangles them):
#   cl /EP <file.r> > PiPL.rr ; PiPLtool PiPL.rr PiPL.rrc ; cl /D MSWindows /EP PiPL.rrc > PiPL.rc
# Inputs (-D): CL, PIPLTOOL, SRC, OUTDIR, INCS ("|"-separated dirs), DEFS ("|"-separated NAME or NAME=VALUE)
string(REPLACE "|" ";" _incs "${INCS}")
string(REPLACE "|" ";" _defs "${DEFS}")
set(_args /nologo)
foreach(d IN LISTS _defs)
  if(d)
    list(APPEND _args "/D${d}")
  endif()
endforeach()
foreach(i IN LISTS _incs)
  if(i)
    list(APPEND _args /I "${i}")
  endif()
endforeach()
execute_process(COMMAND "${CL}" ${_args} /EP "${SRC}" OUTPUT_FILE "${OUTDIR}/PiPL.rr" RESULT_VARIABLE r1 WORKING_DIRECTORY "${OUTDIR}")
if(r1)
  message(FATAL_ERROR "PiPL preprocess failed (${r1})")
endif()
execute_process(COMMAND "${PIPLTOOL}" PiPL.rr PiPL.rrc RESULT_VARIABLE r2 WORKING_DIRECTORY "${OUTDIR}")
if(r2 OR NOT EXISTS "${OUTDIR}/PiPL.rrc")
  message(FATAL_ERROR "PiPLtool failed (${r2})")
endif()
execute_process(COMMAND "${CL}" /nologo /DMSWindows /EP PiPL.rrc OUTPUT_FILE "${OUTDIR}/PiPL.rc" RESULT_VARIABLE r3 WORKING_DIRECTORY "${OUTDIR}")
if(r3)
  message(FATAL_ERROR "PiPL second preprocess failed (${r3})")
endif()
